# ───────── Painel ─────────
# Senha para entrar no painel (obrigatório em produção)
ADMIN_PASSWORD=troque-esta-senha
# Texto aleatório para assinar a sessão
SESSION_SECRET=um-texto-aleatorio-bem-grande
# Pasta do banco SQLite e das imagens (monte um volume aqui em produção)
DATA_DIR=./data
# URL pública onde o painel vai rodar (usada para montar o webhook)
PUBLIC_URL=https://afiliados.seudominio.com

# ───────── Evolution API (v2) ─────────
EVOLUTION_API_URL=https://evolution.seudominio.com
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
# Segredo que vai na URL do webhook (?token=...)
WEBHOOK_TOKEN=um-token-secreto

# ───────── Mercado Livre Afiliados ─────────
# generator = Gerador de Links oficial (link curto meli.la), precisa do cookie da sua sessão
# params    = monta o link com matt_word/matt_tool e encurta com o SHORTENER
MELI_STRATEGY=generator
MELI_AFFILIATE_TAG=
MELI_COOKIE=
MELI_CSRF_TOKEN=
MELI_MATT_TOOL=
MELI_EXTRA_PARAMS=
# none | tinyurl | isgd | bitly
SHORTENER=none
BITLY_TOKEN=

# ───────── IA opcional ─────────
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5

# Landing page do anúncio (/grupo). Também dá pra preencher em Configurações.
GROUP_INVITE_URL=
META_PIXEL_ID=
